{
  "name": "newpeoplech-photo-batch",
  "version": "0.1.0",
  "private": true,
  "description": "Synology Photos 타임라인에서 교회 행사 사진을 날짜별로 다운로드하여 로컬 앨범 폴더에 정리하는 자동화 스크립트",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "scan": "node scripts/scanFolders.js",
    "import": "node scripts/importArchive.js",
    "login": "node scripts/login.js",
    "sync": "node scripts/run.js",
    "sync:dry": "node scripts/run.js --dry-run",
    "upload": "node scripts/uploadToBoard.js",
    "upload:dry": "node scripts/uploadToBoard.js --dry-run",
    "report:upload": "node scripts/generateUploadReport.js",
    "upload:api": "node scripts/uploadPhotoLibraryApi.js",
    "upload:api:dry": "node scripts/uploadPhotoLibraryApi.js --dry-run"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "dotenv": "^16.4.5",
    "heic-convert": "^2.1.0",
    "playwright": "^1.48.0",
    "sharp": "^0.33.5"
  }
}
